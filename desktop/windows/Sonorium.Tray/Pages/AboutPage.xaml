<?xml version="1.0" encoding="utf-8"?>
<!-- Board Win_About -->
<Page
    x:Class="Sonorium.Tray.Pages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:t="using:Sonorium.Tray">
    <ScrollViewer>
        <StackPanel>
            <TextBlock Text="About" Style="{StaticResource TitleTextBlockStyle}" Margin="0,4,0,18" />
            <t:SettingCard>
                <Grid Padding="18" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Image Source="ms-appx:///Assets/Logo.png" Width="56" Height="56" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Sonorium" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock x:Name="Version" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" />
                    </StackPanel>
                    <Button Grid.Column="2" Content="Copy version" VerticalAlignment="Center" Click="CopyVersion_Click" />
                </Grid>
            </t:SettingCard>
            <TextBlock Text="Links" FontWeight="SemiBold" Margin="0,18,0,8" />
            <t:SettingCard>
                <t:SettingRow Glyph="&#xE774;" Title="sonorium.app" Description="Guides and help.">
                    <Button Content="Open" Tag="https://sonorium.app" Click="Open_Click" />
                </t:SettingRow>
                <t:SettingRow Glyph="&#xE897;" Title="Report a problem" Description="On GitHub.">
                    <Button Content="Open" Tag="https://github.com/synssins/sonorium/issues" Click="Open_Click" />
                </t:SettingRow>
                <t:SettingRow Glyph="&#xE946;" Title="License" Description="PolyForm Noncommercial 1.0.0.">
                    <Button Content="Open" Tag="LICENSE.md" Click="Open_Click" />
                </t:SettingRow>
                <t:SettingRow Glyph="&#xE8A5;" Title="Third-party notices" Description="FFmpeg (LGPL), Python, .NET and the other parts Sonorium uses.">
                    <Button Content="Open" Tag="THIRD_PARTY_NOTICES.md" Click="Open_Click" />
                </t:SettingRow>
            </t:SettingCard>
        </StackPanel>
    </ScrollViewer>
</Page>
