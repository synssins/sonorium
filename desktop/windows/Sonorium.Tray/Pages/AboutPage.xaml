<?xml version="1.0" encoding="utf-8"?>
<!-- Name and version only until the About board (Win_About) is approved -->
<Page
    x:Class="Sonorium.Tray.Pages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:t="using:Sonorium.Tray">
    <StackPanel>
        <TextBlock Text="About" Style="{StaticResource TitleTextBlockStyle}" Margin="0,4,0,18" />
        <t:SettingCard>
            <StackPanel Orientation="Horizontal" Spacing="16" Padding="18">
                <Image Source="ms-appx:///Assets/Logo.png" Width="56" Height="56" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Sonorium" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock x:Name="Version" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </StackPanel>
        </t:SettingCard>
    </StackPanel>
</Page>
