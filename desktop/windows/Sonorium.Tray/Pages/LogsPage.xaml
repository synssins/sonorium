<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Sonorium.Tray.Pages.LogsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:p="using:Sonorium.Tray.Pages">
    <Grid RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Text="Logs" Style="{StaticResource TitleTextBlockStyle}" Margin="0,4,0,8" />
        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <AutoSuggestBox x:Name="Search" PlaceholderText="Search" QueryIcon="Find" AutomationProperties.Name="Search" />
            <RadioButtons x:Name="Level" Grid.Column="1" MaxColumns="3" SelectedIndex="0" AutomationProperties.Name="Show">
                <x:String>All</x:String>
                <x:String>Warnings</x:String>
                <x:String>Errors</x:String>
            </RadioButtons>
            <Button Grid.Column="3" Content="Copy" Click="Copy_Click" />
            <Button Grid.Column="4" Content="Save…" Click="Save_Click" />
            <Button Grid.Column="5" Content="Open folder" Click="OpenFolder_Click" />
        </Grid>
        <Border Grid.Row="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6">
            <ListView x:Name="Lines" SelectionMode="Extended" Padding="4,8" IsItemClickEnabled="False">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="MinHeight" Value="0" />
                        <Setter Property="Padding" Value="12,1" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="p:LogLine">
                        <TextBlock Text="{x:Bind Text}" Foreground="{x:Bind Foreground}" FontFamily="Cascadia Mono, Consolas" FontSize="12" TextWrapping="NoWrap" IsTextSelectionEnabled="True" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>
    </Grid>
</Page>
