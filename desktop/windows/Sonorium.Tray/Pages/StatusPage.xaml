<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Sonorium.Tray.Pages.StatusPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:t="using:Sonorium.Tray">
    <ScrollViewer>
        <StackPanel>
            <TextBlock Text="Status" Style="{StaticResource TitleTextBlockStyle}" Margin="0,4,0,18" />
            <t:SettingCard>
                <Grid Padding="18,20" ColumnSpacing="18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Ellipse x:Name="Dot" Width="14" Height="14" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="State" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock x:Name="Detail" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Style="{StaticResource AccentButtonStyle}" Click="Open_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE8A7;" FontSize="16" /><TextBlock Text="Open Sonorium" /></StackPanel>
                        </Button>
                        <Button Click="Restart_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE72C;" FontSize="16" /><TextBlock Text="Restart" /></StackPanel>
                        </Button>
                        <Button Click="StopStart_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon x:Name="StopStartIcon" Glyph="&#xE71A;" FontSize="16" /><TextBlock x:Name="StopStartText" Text="Stop" /></StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </t:SettingCard>
            <TextBlock Text="Right now" FontWeight="SemiBold" Margin="0,18,0,8" />
            <t:SettingCard>
                <t:SettingRow x:Name="Channels" Glyph="&#xE930;">
                    <Button Click="StatusPage_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE8A7;" FontSize="16" /><TextBlock Text="Open Status page" /></StackPanel>
                    </Button>
                </t:SettingRow>
                <t:SettingRow x:Name="HomeAssistant" Glyph="&#xE71B;" Title="Home Assistant">
                    <TextBlock x:Name="HaState" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </t:SettingRow>
                <t:SettingRow x:Name="Mqtt" Glyph="&#xE71B;" Title="MQTT">
                    <TextBlock x:Name="MqttState" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </t:SettingRow>
                <t:SettingRow x:Name="UpdatesRow" Glyph="&#xE895;" Title="Updates">
                    <!-- Goes to Updates and checks there (Chris, 2026-10-13) -->
                    <Button Click="CheckNow_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE895;" FontSize="16" /><TextBlock Text="Check now" /></StackPanel>
                    </Button>
                </t:SettingRow>
            </t:SettingCard>
        </StackPanel>
    </ScrollViewer>
</Page>
