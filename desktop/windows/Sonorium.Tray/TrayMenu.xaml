<?xml version="1.0" encoding="utf-8"?>
<!-- The tray icon's menu (board Win_Tray): status, then the actions. A small borderless window,
     because a standard menu can't show the status lines or the update dot. -->
<Window
    x:Class="Sonorium.Tray.TrayMenu"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="Root" Width="260" Padding="4" VerticalAlignment="Top">
        <Grid.Resources>
            <Style x:Key="Item" TargetType="Button">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Height" Value="36" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="4" />
            </Style>
            <Style x:Key="Sep" TargetType="Border">
                <Setter Property="Height" Value="1" />
                <Setter Property="Margin" Value="8,4" />
                <Setter Property="Background" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
            </Style>
        </Grid.Resources>
        <StackPanel x:Name="Items">
            <StackPanel Orientation="Horizontal" Spacing="10" Padding="12,10,12,8">
                <Ellipse x:Name="StatusDot" Width="10" Height="10" VerticalAlignment="Center" />
                <StackPanel>
                    <TextBlock x:Name="StatusText" FontWeight="SemiBold" />
                    <TextBlock x:Name="StatusDetail" Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </StackPanel>
            <Border Style="{StaticResource Sep}" />
            <Button Style="{StaticResource Item}" Click="Open_Click">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <FontIcon Glyph="&#xE8A7;" FontSize="16" />
                    <TextBlock Text="Open Sonorium" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource Item}" Click="Settings_Click">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <FontIcon Glyph="&#xE713;" FontSize="16" />
                    <TextBlock Text="Settings…" />
                </StackPanel>
            </Button>
            <Border Style="{StaticResource Sep}" />
            <Button Style="{StaticResource Item}" Click="Restart_Click">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <FontIcon Glyph="&#xE72C;" FontSize="16" />
                    <TextBlock Text="Restart Sonorium" />
                </StackPanel>
            </Button>
            <Button x:Name="StopStart" Style="{StaticResource Item}" Click="StopStart_Click">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <FontIcon x:Name="StopStartIcon" Glyph="&#xE71A;" FontSize="16" />
                    <TextBlock x:Name="StopStartText" Text="Stop Sonorium" />
                </StackPanel>
            </Button>
            <Border Style="{StaticResource Sep}" />
            <Button Style="{StaticResource Item}" Click="Updates_Click">
                <Grid>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE895;" FontSize="16" />
                        <TextBlock Text="Check for updates…" />
                    </StackPanel>
                    <Ellipse x:Name="UpdateDot" Width="8" Height="8" HorizontalAlignment="Right"
                             Fill="{ThemeResource AccentFillColorDefaultBrush}" Visibility="Collapsed" />
                </Grid>
            </Button>
            <Button Style="{StaticResource Item}" Click="Logs_Click">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <FontIcon Glyph="&#xE8A5;" FontSize="16" />
                    <TextBlock Text="Logs…" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource Item}" Click="Help_Click">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <FontIcon Glyph="&#xE897;" FontSize="16" />
                    <TextBlock Text="Help" />
                </StackPanel>
            </Button>
            <Border Style="{StaticResource Sep}" />
            <Button Style="{StaticResource Item}" Click="Quit_Click">
                <Grid>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xF3B1;" FontSize="16" />
                        <TextBlock Text="Quit" />
                    </StackPanel>
                    <TextBlock x:Name="QuitHint" Text="Stops Sonorium" HorizontalAlignment="Right" VerticalAlignment="Center"
                               Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
            </Button>
        </StackPanel>
    </Grid>
</Window>
