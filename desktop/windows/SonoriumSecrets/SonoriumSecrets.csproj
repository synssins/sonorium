<Project Sdk="Microsoft.NET.Sdk">
  <!-- Sonorium's secret helper (SONORIUM_SECRET_HELPER): keeps ha_token and mqtt_password
       encrypted with Windows' DPAPI. WinExe: never opens a console window. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>SonoriumSecrets</AssemblyName>
    <RootNamespace>Sonorium.Secrets</RootNamespace>
    <!-- Published into the tray console's folder, sharing its .NET runtime -->
    <SelfContained>true</SelfContained>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
  </ItemGroup>
</Project>
